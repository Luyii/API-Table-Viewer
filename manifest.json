{
  "manifest_version": 3,
  "name": "API Table Viewer",
  "version": "1.5.2",
  "description": "High-performance JSON API response viewer for Chrome DevTools",
  "devtools_page": "devtools.html",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "field-mock-background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "field-patch-core.js",
        "field-mock-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "field-mock-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
